# ============================================================
# Imran Salara MD Bot — environment configuration
# Copy this file to ".env" and fill in your own values.
# ============================================================

# Token YOU invent for webhook verification (Meta must send the same value back)
VERIFY_TOKEN=imran-salara-verify-123

# WhatsApp Cloud API credentials (from Meta Developer dashboard)
WHATSAPP_TOKEN=your-temporary-or-permanent-access-token
PHONE_NUMBER_ID=your-phone-number-id

# Server port (Heroku sets this automatically)
PORT=3000

# Display name used in .owner / .info replies
OWNER_NAME=Imran Salara

# Public base URL of this app (Heroku app URL, e.g. https://your-app.herokuapp.com)
# Used to build the .menu image URL. Leave blank to send the menu as text only.
APP_URL=

# --- AI auto-reply (OpenAI-compatible /chat/completions endpoint) ---
# Leave blank to disable AI fallback; the bot will reply politely instead.
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Optional public API keys (features degrade gracefully without them) ---
OMDB_API_KEY=
WEATHER_API_KEY=
NEWS_API_KEY=
